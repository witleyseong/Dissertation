# all optional, the server uses these defaults if there is no .env
DATABASE_URL=postgres://safeway:safeway@localhost:5432/safeway
PORT=3000
# secret for the login tokens (default one is used if empty)
JWT_SECRET=
# TfL key from https://api-portal.tfl.gov.uk/ (works without, just a lower rate limit)
TFL_APP_KEY=
